{
  "//": "Type-checks the plain-JS e2e runners (// @ts-check + JSDoc): npm run typecheck:e2e (tsc -p e2e)",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.mjs"]
}
